{
  "name": "pi-web-access-slim",
  "version": "0.1.0",
  "description": "A small Exa-only web search and content-fetching extension for Pi",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "audit:runtime": "npm audit --omit=dev --omit=peer"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "web-search",
    "exa"
  ],
  "author": "Ahmed Essam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/a-essam23/pi-web-access-slim.git"
  },
  "bugs": {
    "url": "https://github.com/a-essam23/pi-web-access-slim/issues"
  },
  "homepage": "https://github.com/a-essam23/pi-web-access-slim",
  "files": [
    "*.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.16.0",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
